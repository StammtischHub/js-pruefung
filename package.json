{
  "name": "js-pruefung",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pruefungsleistung fuer das JS-Modul",
  "main": "index.js",
  "scripts": {
    "dev:bff": "pnpm --filter bff dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "concurrently -n BFF,FRONTEND -c blue,green \"pnpm dev:bff\" \"pnpm dev:frontend\"",
    "dev:docker": "docker compose up --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clear:data": "node scripts/clearData.js",
    "clear:data:dry": "node scripts/clearData.js --dry-run"
  },
  "keywords": [],
  "author": "Simon Budzus, Jannis Dickel, Max Gloeckner, Leon Huttarsch, Julian Benedikt Kirchner, Leon Reusch",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.6"
  }
}
