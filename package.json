{
  "name": "js-pruefung",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pruefungsleistung fuer das JS-Modul",
  "main": "index.js",
  "scripts": {
    "dev:bff": "pnpm --filter bff dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "concurrently -n BFF,FRONTEND -c blue,green \"pnpm dev:bff\" \"pnpm dev:frontend\"",
    "dev:docker": "docker compose up --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Simon Budzus, Jannis Dickel, Max Gloeckner, Leon Huttarsch, Julian Benedikt Kirchner, Leon Reusch",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
